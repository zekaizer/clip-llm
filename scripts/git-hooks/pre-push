#!/usr/bin/env bash
#
# pre-push hook: run the same checks as .github/workflows/ci.yml before a push
# to main, so a red CI is caught locally instead of after the fact.
#
# Install (from repo root):
#   ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push
#
# NOTE: this runs the LOCAL toolchain. Keep it current with CI's `@stable`
# (`rustup update stable`) — an older clippy will miss lints that CI enforces.
#
# Bypass once with: git push --no-verify
set -uo pipefail

protected="refs/heads/main"
run_checks=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    run_checks=1
  fi
done

[ "$run_checks" -eq 1 ] || exit 0

echo "pre-push: running CI-equivalent checks for $protected ..."
set -e
cargo clippy -- -D warnings
cargo test
cargo clippy --features diagnostics -- -D warnings
cargo test --features diagnostics
echo "pre-push: all CI checks passed."
